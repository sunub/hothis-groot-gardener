# Copy to .env.local and edit. Without LLM_MODEL every crisis is a pre-made one.

# --- Language model ---------------------------------------------------------
# ollama: Ollama's own API. openai: any OpenAI-compatible server (vLLM on RunPod, LM Studio).
LLM_PROVIDER=ollama

# Ollama: http://127.0.0.1:11434 (use 127.0.0.1, not localhost, when Ollama runs in WSL).
# OpenAI-compatible: the URL that ends in /v1, e.g. https://<pod-id>-8000.proxy.runpod.net/v1
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:e4b

# Only for OpenAI-compatible servers that need a key.
# LLM_API_KEY=

# Per attempt, in milliseconds. The pipeline tries twice, then shows a pre-made crisis.
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.7

# Ollama only: context window, and thinking mode (false = off, omit = leave the field out).
LLM_NUM_CTX=8192
LLM_THINK=false

# Ollama only: keep the model loaded this long after a request (default 30m; -1 = always).
# Ollama's own default unloads it after 5 minutes, and reloading took about 27 s.
# The server also starts loading the model as soon as it starts (src/instrumentation.ts).
# On demo day, -1 keeps it loaded however long the wait before the demo.
# LLM_KEEP_ALIVE=30m

# Rewrites asked for within one attempt when a reply breaks a rule (0 = off).
# LLM_REPAIRS=1

# Append every generation (input summary, output, problems, time) to <dir>/generations.jsonl.
# LLM_LOG_DIR=logs

# --- Evidence search (rag_server.py) -----------------------------------------
# Background excerpts for the prompt. Unset to turn search off.
# If the search server is not running, generation goes on without excerpts.
RAG_URL=http://127.0.0.1:8000
RAG_TOP_N=4
RAG_TIMEOUT_MS=3000

# --- Cultivation timeline (ROLE-TASKS A1) -------------------------------------
# 1 = new missions walk cultivation days 0-33 with event cards and log lines.
# Off when unset. Saved missions keep the mode they started with.
# Restart `npm run dev` after changing it.
# NEXT_PUBLIC_TIMELINE=1
